# Database Configuration
POSTGRES_USER=ocr_user
POSTGRES_PASSWORD=ocr_password
POSTGRES_DB=ocr_db

# Redis Cache & Broker Password
REDIS_PASSWORD=ocr_redis_secure_pass

# Security & Authentication Settings
INITIAL_ADMIN_EMAIL=admin@example.com
COOKIE_SECURE=false
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Quotas & System Limits
ANONYMOUS_DAILY_CONVERSIONS=3
FREE_DAILY_CONVERSIONS=3
FREE_MAX_FILE_MB=10
FREE_MAX_PDF_PAGES=5
MAX_FILE_SIZE_MB=10
MAX_PDF_MB=50
MAX_PDF_PAGES=100
OCR_TIMEOUT_SECONDS=300

# Mailer Settings (Mailpit / Production SMTP)
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAILS_FROM_EMAIL=noreply@scantext.io
EMAILS_FROM_NAME=ScanText OCR
SMTP_USER=
SMTP_PASSWORD=

# Stripe Subscriptions & Billing (Phase 4)
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_signing_secret
STRIPE_PRO_MONTHLY_PRICE_ID=price_replace_with_your_pro_price_id
STRIPE_DISPLAY_PRICE=19.00
STRIPE_CURRENCY=USD
STRIPE_ALLOW_PROMO_CODES=true
STRIPE_GRACE_PERIOD_DAYS=3
STRIPE_PORTAL_ALLOW_CANCEL=true
STRIPE_PORTAL_RETURN_URL=/dashboard
PRO_DAILY_CONVERSIONS=100
PRO_MAX_FILE_MB=50
PRO_MAX_PDF_PAGES=100

# Google OAuth 2.0 (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/api/v1/auth/google/callback

