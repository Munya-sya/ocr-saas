[Unit]
Description=ScanText OCR SaaS Deployment Runner
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/ocr-saas
ExecStart=/opt/ocr-saas/deployment/deploy.sh /etc/scantext/release-manifest.json
StandardOutput=journal
StandardError=journal
